{
  "name": "money-ledger",
  "version": "0.0.0",
  "description": "記帳本 PWA — 個人記帳、分帳、投資與雲端同步",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/stamp-build.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run build && vitest run",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"build/**/*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"build/**/*.js\" \"scripts/**/*.js\"",
    "icons": "node scripts/generate-icons.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjurdt/Money.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/tjurdt/Money/issues"
  },
  "homepage": "https://github.com/tjurdt/Money#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "private": true
}
